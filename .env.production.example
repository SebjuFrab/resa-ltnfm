# Copiez ce fichier vers .env.production, remplacez toutes les valeurs change-me,
# puis protégez-le avec : chmod 600 .env.production
COMPOSE_PROJECT_NAME=ltnm_resa
# Changez ce tag à chaque release pour conserver les images précédentes.
APP_RELEASE=2026-07-22.1
APP_DOMAIN=resa-ltnfm.agrobio-bretagne.org
# Si ce port change, mettez aussi à jour le proxy_pass Nginx.
APP_HTTP_PORT=18001
# Gardez cet UID et le nom du projet stables après le premier déploiement.
APP_UID=10001

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=resa-ltnfm.agrobio-bretagne.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://resa-ltnfm.agrobio-bretagne.org
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1
TRUST_PROXY_HEADERS=1
ENABLE_LEGACY_PUBLIC_FLOW=0

POSTGRES_DB=ltnm
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_APP_USER=ltnm_app
POSTGRES_APP_PASSWORD=change-me
POSTGRES_CONNECT_TIMEOUT=5
REDIS_URL=redis://redis:6379/0
CACHE_KEY_PREFIX=ltnm_resa

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=change-me@agrobio-bretagne.org
ORGANIZATION_EMAIL=change-me@agrobio-bretagne.org
ORGANIZATION_PHONE=

EVENT_DATES=2026-09-23,2026-09-24
REGISTRATION_EDIT_DEADLINE=2026-09-16T23:59:00+02:00
DRAFT_HOLD_MINUTES=60
DATA_RETENTION_DAYS=730
MANAGEMENT_SESSION_SECONDS=3600

# Le timeout élevé limite les interruptions pendant les publipostages synchrones.
# Une file de tâches reste recommandée avant une campagne volumineuse.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=300
GUNICORN_MAX_REQUESTS=1000

# Limites adaptées à un serveur partagé ; ajustez-les après mesure.
WEB_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.50
REDIS_MAXMEMORY=192mb

BACKUP_RETENTION_DAYS=14
